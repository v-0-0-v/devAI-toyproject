# Copy to server/.env.production and fill in. Gitignored (matches ".env*").
# Used by: docker-compose.prod.yml (caddy, server, coturn services all read
# this via env_file) and directly by the Node server when NOT containerized.
#
#   cp server/.env.production.example server/.env.production
#
# See deploy/DEPLOY.md for the full walkthrough.

NODE_ENV=production
PORT=3001

# The domain the app is served from (must have a DNS A record pointing at
# this VPS). Caddy requests its own TLS cert for this automatically.
APP_DOMAIN=app.example.com
CLIENT_ORIGIN=https://app.example.com

# Contact address Let's Encrypt uses for expiry/problem notices about
# certs issued to APP_DOMAIN.
ACME_EMAIL=you@example.com

# --- mediasoup SFU (video chat's actual media path — see sfu.ts) ---
# The VPS's public IP (not domain — mediasoup advertises this literally in
# ICE candidates). Required: without it, candidates advertise the
# container-internal bind address and every client's video chat silently
# fails to connect.
MEDIASOUP_ANNOUNCED_IP=203.0.113.10

# Bind inside the container to all interfaces so docker-compose.prod.yml's
# port mapping can route to it — 127.0.0.1 (the local-dev default) would be
# unreachable from outside the container.
MEDIASOUP_LISTEN_IP=0.0.0.0

# Must match the port range docker-compose.prod.yml publishes for the
# server service, and the range opened in the VPS firewall.
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# --- TURN (coturn) — no longer used by the app itself ---
# Video chat's media now goes through mediasoup above, which doesn't have
# P2P's NAT-traversal problem (the server is always one side of the
# connection). This whole section is only needed if you want coturn running
# for some other reason; see README. Separate subdomain with its own DNS A
# record → this VPS. Needs its own certbot-issued cert (see deploy/DEPLOY.md)
# since coturn doesn't speak Caddy's automatic-HTTPS protocol.
TURN_DOMAIN=turn.example.com

# Must be long/random: openssl rand -hex 32
TURN_SECRET=change-me-to-a-long-random-string

# Handed to clients as-is. Include both the plain and TLS TURN endpoints so
# the browser can fall back to TURNS/TCP on networks that block UDP.
TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp

TURN_TTL_SECONDS=3600

# --- Optional: horizontal scaling + admin moderation ---
# Point every server instance at the same Redis to run more than one behind a
# load balancer (see README's "다음 단계"/store.ts doc comment for what this
# does and doesn't cover). Leave unset for a single instance.
# REDIS_URL=redis://your-redis-host:6379

# Lets a client authenticate as admin (?admin=TOKEN) to ban players by IP,
# view the persisted report log, and save changes from the map editor.
# Leave unset to disable admin login entirely.
# ADMIN_TOKEN=change-me-to-a-long-random-string

# SQLite persistence (whiteboard strokes + reports) defaults to /app/data
# inside the container, which docker-compose.prod.yml mounts as a named
# volume — no override needed unless you want it elsewhere.
# DB_PATH=/app/data/zep.db
