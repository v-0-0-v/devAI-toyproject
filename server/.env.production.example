# Copy to server/.env.production and fill in. Gitignored (matches ".env*").
# Used by: docker-compose.prod.yml (caddy, server, coturn services all read
# this via env_file) and directly by the Node server when NOT containerized.
#
#   cp server/.env.production.example server/.env.production
#
# See deploy/DEPLOY.md for the full walkthrough.

NODE_ENV=production
PORT=3001

# The domain the app is served from (must have a DNS A record pointing at
# this VPS). Caddy requests its own TLS cert for this automatically.
APP_DOMAIN=app.example.com
CLIENT_ORIGIN=https://app.example.com

# Contact address Let's Encrypt uses for expiry/problem notices about
# certs issued to APP_DOMAIN.
ACME_EMAIL=you@example.com

# --- TURN (coturn) ---
# Separate subdomain with its own DNS A record → this VPS. Needs its own
# certbot-issued cert (see deploy/DEPLOY.md) since coturn doesn't speak
# Caddy's automatic-HTTPS protocol.
TURN_DOMAIN=turn.example.com

# Must be long/random: openssl rand -hex 32
TURN_SECRET=change-me-to-a-long-random-string

# Handed to clients as-is. Include both the plain and TLS TURN endpoints so
# the browser can fall back to TURNS/TCP on networks that block UDP.
TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp

TURN_TTL_SECONDS=3600
