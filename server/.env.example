# Copy to .env and fill in. .env is gitignored.

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# TURN relay (see ../docker-compose.yml + ../turnserver.conf).
# Must match the coturn container's --static-auth-secret exactly.
# Generate a strong value, e.g.: openssl rand -hex 32
TURN_SECRET=change-me-to-a-long-random-string

# Comma-separated TURN URLs handed to clients. For local dev with the bundled
# docker-compose coturn this is turn:localhost:3478. In production this must
# be a publicly reachable host/IP (see README's "Production TURN notes").
TURN_URLS=turn:localhost:3478

# How long (seconds) each minted TURN credential stays valid.
TURN_TTL_SECONDS=3600
