# Copy to .env and fill in. .env is gitignored.

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# TURN relay (see ../docker-compose.yml + ../turnserver.conf). No longer used
# by the app itself — video chat now goes through mediasoup (see MEDIASOUP_*
# below), which doesn't need TURN's NAT-traversal relay. Left here in case
# you still want coturn running for some other reason; see README.
# Must match the coturn container's --static-auth-secret exactly.
# Generate a strong value, e.g.: openssl rand -hex 32
TURN_SECRET=change-me-to-a-long-random-string

# Comma-separated TURN URLs. For local dev with the bundled docker-compose
# coturn this is turn:localhost:3478.
TURN_URLS=turn:localhost:3478

# How long (seconds) each minted TURN credential stays valid.
TURN_TTL_SECONDS=3600

# Optional: mediasoup SFU (see sfu.ts) config. Defaults (127.0.0.1, no
# announced IP, ports 40000-40100) work out of the box for local dev on one
# machine. Anything beyond that — another device on the LAN, Docker,
# production — needs these set explicitly, or video chat will silently fail
# (ICE candidates advertise an unreachable address).
# MEDIASOUP_LISTEN_IP=0.0.0.0
# MEDIASOUP_ANNOUNCED_IP=203.0.113.10
# MEDIASOUP_MIN_PORT=40000
# MEDIASOUP_MAX_PORT=40100

# Optional: point every instance at the same Redis to run more than one
# server process behind a load balancer (sticky sessions still required —
# see README). Unset = single-instance, fully in-memory (no extra infra).
# REDIS_URL=redis://localhost:6379

# Optional: lets a client authenticate as admin (?admin=TOKEN in the URL) to
# ban players by IP, view reports, and save changes from the map editor.
# Unset = admin login is disabled entirely.
# ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional: override where the SQLite persistence file (whiteboard strokes +
# reports, see persistence.ts) is written. Defaults next to the compiled
# server, in a "data" directory alongside dist/.
# DB_PATH=./data/zep.db

# Optional: override where the map data JSON (see map.ts) is read from.
# Defaults to mapdata.json shipped alongside the compiled server.
# MAP_DATA_PATH=./dist/mapdata.json
